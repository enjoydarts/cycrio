    {
      "dashboard": "ai",
      "name": "モデル別の入力・出力トークン",
      "query": {
        "kind": "TrendsQuery",
        "dateRange": {
          "date_from": "-14d"
        },
        "interval": "day",
        "filterTestAccounts": false,
        "series": [
          {
            "kind": "EventsNode",
            "event": "$ai_generation",
            "name": "$ai_generation",
            "math": "sum",
            "custom_name": "入力",
            "math_property": "$ai_input_tokens",
            "properties": [
              {
                "key": "usage_known",
                "type": "event",
                "operator": "exact",
                "value": "true"
              }
            ]
          },
          {
            "kind": "EventsNode",
            "event": "$ai_generation",
            "name": "$ai_generation",
            "math": "sum",
            "custom_name": "出力",
            "math_property": "$ai_output_tokens",
            "properties": [
              {
                "key": "usage_known",
                "type": "event",
                "operator": "exact",
                "value": "true"
              }
            ]
          }
        ],
