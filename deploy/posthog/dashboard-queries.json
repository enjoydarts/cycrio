{
  "version": 1,
  "dashboards": [
    {
      "key": "operations",
      "name": "Cycrio 運用状況"
    },
    {
      "key": "ai",
      "name": "Cycrio AI実行状況"
    },
    {
      "key": "usage",
      "name": "Cycrio 利用状況"
    }
  ],
  "charts": [
    {
      "dashboard": "operations",
      "name": "Workerタスクの結果",
      "query": {
        "kind": "TrendsQuery",
        "dateRange": {
          "date_from": "-14d"
        },
        "interval": "day",
        "filterTestAccounts": false,
        "series": [
          {
            "kind": "EventsNode",
            "event": "cycrio_job_completed",
            "name": "cycrio_job_completed",
            "math": "total"
          }
        ],
        "trendsFilter": {
          "display": "ActionsBar",
          "showLegend": true
        },
        "breakdownFilter": {
          "breakdowns": [
            {
              "type": "event",
              "property": "state"
            }
          ]
        }
      }
    },
