    {
      "dashboard": "usage",
      "name": "接続テスト→取り込み→契約登録（7日以内）",
      "query": {
        "kind": "FunnelsQuery",
        "dateRange": {
          "date_from": "-14d"
        },
        "filterTestAccounts": false,
        "series": [
          {
            "kind": "EventsNode",
            "event": "cycrio_job_completed",
            "custom_name": "接続テスト成功",
            "properties": [
              {
                "key": "operation",
                "type": "event",
                "operator": "exact",
                "value": "worker_mail_probe"
              },
              {
                "key": "state",
                "type": "event",
                "operator": "exact",
                "value": "succeeded"
              }
            ]
          },
          {
            "kind": "EventsNode",
            "event": "cycrio_job_completed",
            "custom_name": "取り込み完了",
            "properties": [
              {
                "key": "operation",
                "type": "event",
                "operator": "exact",
                "value": "worker_mail_discovery"
              },
              {
                "key": "state",
                "type": "event",
                "operator": "exact",
                "value": "succeeded"
              }
            ]
          },
          {
            "kind": "EventsNode",
            "event": "cycrio_api_operation",
            "custom_name": "契約登録API成功",
            "properties": [
              {
                "key": "action",
                "type": "event",
                "operator": "exact",
                "value": "subscription_create"
              },
              {
                "key": "state",
                "type": "event",
                "operator": "exact",
                "value": "succeeded"
              }
            ]
          }
        ],
        "funnelsFilter": {
          "funnelOrderType": "ordered",
          "funnelWindowInterval": 7,
          "funnelWindowIntervalUnit": "day",
          "funnelVizType": "steps",
          "layout": "vertical"
        }
      }
    },
