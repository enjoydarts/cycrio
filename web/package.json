{
  "name": "cycrio-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "browser-tabs-lock@1.3.0": false,
    "core-js@3.47.0": false
  },
  "scripts": {
    "pretest": "node scripts/generate-service-logos.mjs",
    "test": "node --test scripts/*.test.mjs src/lib/*.test.ts",
    "predev": "node scripts/generate-service-logos.mjs",
    "dev": "vite dev --host 0.0.0.0 --port 5173",
    "precheck": "node scripts/generate-service-logos.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prebuild": "node scripts/generate-service-logos.mjs",
    "build": "vite build",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "overrides": {
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "simple-icons": "16.36.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "@clerk/clerk-js": "6.40.1",
    "@clerk/localizations": "4.24.1",
    "@clerk/ui": "1.41.2"
  }
}
